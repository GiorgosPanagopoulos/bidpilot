ANTHROPIC_API_KEY=sk-ant-...
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB_NAME=bidpilot
CHROMA_PATH=./chroma_data
TED_API_BASE=https://api.ted.europa.eu/v3

# Matching weights (must sum to 1.0)
WEIGHT_SEMANTIC=0.6
WEIGHT_RULE=0.4
MATCH_TOP_K=20
BUDGET_FEASIBILITY_FACTOR=2.0

# Cron schedule for automatic ingestion (default: daily at 06:00 UTC)
INGEST_CRON=0 6 * * *

LOG_LEVEL=INFO

# Drafting agent model — override to use a different Anthropic Sonnet/Opus/Haiku variant.
AGENT_MODEL=claude-sonnet-4-5

# Auth: JWT signing key, at least 32 chars (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Public demo account (one-click login). Empty DEMO_EMAIL disables POST /auth/demo.
DEMO_EMAIL=
DEMO_DAILY_DRAFTS=2
